# MessMate Backend Environment Variables (Example Template)
# Copy this file to .env for local overrides or configure in your cloud host (e.g. Render, Supabase, Railway)

# Secret key for JWT session tokens (generate a strong random string in production)
SECRET_KEY=messmate-super-secret-jwt-key-2026-btech-knit

# Shared HMAC secret key for short-lived rotating QR tokens
QR_HMAC_SECRET=messmate-hmac-qr-signing-secret-key-30s

# Database URL:
# For local SQLite development (default):
DATABASE_URL=sqlite:///./messmate.db

# For Cloud PostgreSQL (e.g. Supabase, Neon, AWS RDS, Railway):
# DATABASE_URL=postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres

# JWT Access token expiration in minutes (default 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# QR code token rotation expiry in seconds (default 60s)
QR_EXPIRY_SECONDS=60

