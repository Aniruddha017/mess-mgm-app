# --- Environment & Secret Files ---
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example

# --- Local Databases ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
messmate.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
venv/
venv*/
.venv/
env/
env*/
ENV/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# --- Node / React Native / Expo ---
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Android Native Build Artifacts ---
.gradle/
.idea/
local.properties
.cxx/
**/build/
*.apk
*.aab
*.jks
*.keystore
*.p8
*.p12
*.key
